# Telegram Bot Token from @BotFather (required at runtime)
BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to interact with the bot
# Leave empty only during local development; recommended to restrict in production
ALLOWED_USER_IDS=

# Path or binary name for Antigravity CLI (default: agy)
AGY_BIN=agy

# Base Gemini directory (default: ~/.gemini)
GEMINI_DIR=~/.gemini

# Antigravity CLI app data directory (default: ~/.gemini/antigravity-cli)
APP_DATA_DIR=~/.gemini/antigravity-cli

# Bot persistent storage directory for SQLite DB and runtime state (default: ./data)
DATA_DIR=./data

# Default LLM model ID for new conversations (optional; leaves agy default if blank)
DEFAULT_MODEL=

# Default reasoning effort: low | medium | high | xhigh | max (default: medium)
DEFAULT_EFFORT=medium

# Default permission mode: auto | accept-edits | plan (default: auto)
DEFAULT_MODE=auto

# Minimum interval (ms) between live Telegram message edits while streaming (default: 1200)
STREAM_EDIT_INTERVAL_MS=1200

# Maximum duration (ms) for a single agy turn before timing out (default: 600000)
MAX_TURN_TIMEOUT_MS=600000

# Bot interface language (e.g., en, fa) (default: en)
BOT_LANG=en
